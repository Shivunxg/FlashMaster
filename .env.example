DATABASE_URL="file:./dev.db"

# The account with this email is promoted to admin the first time it
# successfully signs in at /admin/login (still requires that account's
# real password — this alone grants nothing). Sign up normally with this
# email first, then log in at /admin/login.
SUPERADMIN_EMAIL=

